# ==========================================
# EmoSense Environment Variables Configuration
# ==========================================

# 1. Backend Configuration
PORT=5000
NODE_ENV=production

# 2. Database
MONGODB_URI=mongodb://mongodb:27017/emosense

# 3. Security
# Replace with a strong, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# 4. Service URLs
AI_SERVICE_URL=http://ai-service:8000
# Update CLIENT_URL to your actual production domain (e.g., https://emosense-beta.vercel.app)
CLIENT_URL=http://localhost:80

# 5. AI Vision Engine (Groq Cloud API)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 6. External APIs (Optional)
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
