# ==========================================
# EmoSense Environment Variables Configuration
# ==========================================

# 1. Backend Configuration
PORT=5000
NODE_ENV=production

# 2. Database
MONGODB_URI=mongodb://mongodb:27017/emosense

# 3. Security
# Replace with a strong, random string in production
JWT_SECRET=your_super_secret_jwt_key_here

# 4. Service URLs
AI_SERVICE_URL=http://ai-service:8000
# Update CLIENT_URL to your actual production domain
CLIENT_URL=http://localhost:80

# 5. External APIs (Optional)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-proj-...
